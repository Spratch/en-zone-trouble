---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <h1>404</h1>
    <h2>Aucune page trouvée</h2>
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    text-align: center;

    & h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    & h2 {
      font-size: 2rem;
    }
  }
</style>
