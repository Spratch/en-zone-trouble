---
import { sanityClient } from "sanity:client";
import CustomLink from "../../components/CustomLink.astro";
import Gallery from "../../components/Gallery.astro";
import PortableText from "../../components/PortableText.astro";
import Layout from "../../layouts/Layout.astro";
import { showBySlugQuery, showsListQuery } from "../../sanity/lib/queries";

export async function getStaticPaths() {
  const showsList = await sanityClient.fetch(showsListQuery);
  if (!showsList) throw new Error("Shows not found");
  const { shows } = showsList;
  return shows.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const show = await sanityClient.fetch(showBySlugQuery, { slug });
if (!show) throw new Error("Show not found");
---

<Layout title={show.title}>
  <main class="show-page item-page">
    <h1>{show.title}</h1>
    <section class="page-grid">
      <div class="page-left">
        {/* Synopsis */}
        <PortableText
          class="synopsis"
          value={show.synopsis}
        />

        {/* Infos */}
        <section class="details">
          {/* Special links */}
          {
            (show.reservationLink || show.presentationFile) && (
              <div class="special-links">
                {show.reservationLink && (
                  <CustomLink href={show.reservationLink}>Réserver</CustomLink>
                )}
                {show.presentationFile && (
                  <CustomLink
                    href={`${show.presentationFile.url}?dl=${show.presentationFile.originalFilename}`}
                  >
                    Dossier de présentation
                  </CustomLink>
                )}
              </div>
            )
          }

          {
            show.infos && (
              <PortableText
                class="infos"
                value={show.infos}
              />
            )
          }
          {show.production && <p class="production">{show.production}</p>}
          {
            show.supports && (
              <div class="supports">
                <h2>Soutiens</h2>
                <p class="supports-content">{show.supports}</p>
              </div>
            )
          }
          {
            show.links && (
              <div class="links">
                {show.links.map((link) => (
                  <div class="link-item-container">
                    <CustomLink href={link.url}>{link.title}</CustomLink>
                    {link.subtitle && (
                      <p class="link-item-subtitle">{link.subtitle}</p>
                    )}
                  </div>
                ))}
              </div>
            )
          }
          {
            show.press && (
              <div class="press">
                {show.press.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-item"
                  >
                    <span class="link-item-title">{link.title}</span>
                  </a>
                ))}
              </div>
            )
          }
        </section>
      </div>

      <aside class="page-right">
        {/* Extrait */}
        {show.excerpt && <p class="excerpt">{show.excerpt}</p>}

        {/* Crédits */}
        {
          show.credits && (
            <div class="credits">
              {show.credits.map((credit) => (
                <>
                  <p class="credit-title">{credit.title}</p>
                  <div class="credit-value">
                    {credit.value?.map((value) =>
                      value?._type === "personText" ? (
                        <PortableText value={value.text} />
                      ) : (
                        <p>{value.name}</p>
                      )
                    )}
                  </div>
                </>
              ))}
            </div>
          )
        }
      </aside>
    </section>
  </main>
  {/* Galerie */}
  {show.gallery && <Gallery gallery={show.gallery} />}
</Layout>
