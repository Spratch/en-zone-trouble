---
import { sanityClient } from "sanity:client";
import Img from "../../components/Img.astro";
import PortableText from "../../components/PortableText.astro";
import Layout from "../../layouts/Layout.astro";
import { showBySlugQuery, showsListQuery } from "../../sanity/lib/queries";

export async function getStaticPaths() {
  const shows = await sanityClient.fetch(showsListQuery);
  return shows.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const show = await sanityClient.fetch(showBySlugQuery, { slug });
if (!show) throw new Error("Show not found");
---

<Layout>
  <main class="show-page item-page">
    <div class="page-left">
      <h1>{show.title}</h1>

      {/* Synopsis */}
      <PortableText class="synopsis" portableText={show.synopsis} />

      {/* Infos */}
      <section class="details">
        {show.infos && <PortableText class="infos" portableText={show.infos} />}
        {show.production && <p class="production">{show.production}</p>}
        {
          show.supports && (
            <div class="supports">
              <h2>Soutiens</h2>
              <p class="supports-content">{show.supports}</p>
            </div>
          )
        }
        {
          show.links && (
            <div class="links">
              {show.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-item"
                >
                  <span class="link-item-title">{link.title}</span>
                </a>
              ))}
            </div>
          )
        }
        {
          show.press && (
            <div class="press">
              {show.press.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-item"
                >
                  <span class="link-item-title">{link.title}</span>
                </a>
              ))}
            </div>
          )
        }
      </section>
    </div>

    <aside>
      {/* Extrait */}
      {
        show.excerpt &&
          (show.excerpt.type === "text" ? (
            <p class="excerpt">{show.excerpt.text!}</p>
          ) : (
            <Img class="excerpt" image={show.excerpt.image!} />
          ))
      }

      {/* Crédits */}
      {
        show.credits && (
          <div class="credits">
            {show.credits.map((credit) => (
              <>
                <p class="credit-title">{credit.title}</p>
                <div class="credit-value">
                  {credit.value?.map((value) =>
                    value?._type === "personText" ? (
                      <PortableText portableText={value.text} />
                    ) : (
                      <p>{value.name}</p>
                    ),
                  )}
                </div>
              </>
            ))}
          </div>
        )
      }
    </aside>
  </main>
  {/* Galerie */}
  {
    show.gallery && (
      <div class="gallery">
        {show.gallery.map((image) => (
          <Img class="gallery-item" image={image} />
        ))}
      </div>
    )
  }
</Layout>
