---
import { sanityClient } from "sanity:client";
import DetailsParagraph from "../../components/DetailsParagraph.astro";
import Gallery from "../../components/Gallery.astro";
import PortableText from "../../components/PortableText.astro";
import Layout from "../../layouts/Layout.astro";
import { showBySlugQuery, showsListQuery } from "../../sanity/lib/queries";

export async function getStaticPaths() {
  const showsList = await sanityClient.fetch(showsListQuery);
  if (!showsList) throw new Error("Shows not found");
  const { shows } = showsList;
  return shows.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const show = await sanityClient.fetch(showBySlugQuery, { slug });
if (!show) throw new Error("Show not found");

const seoDescription = `${show.synopsis[0]?.children?.[0]?.text?.substring(0, 159)}…`;
const specialLinks = [
  ...(show.reservationLink
    ? [
        {
          title: "Réservation",
          url: show.reservationLink,
          _key: "reservation"
        }
      ]
    : []),
  ...(show.presentationFile
    ? [
        {
          title: "Fiche de présentation",
          url: `${show.presentationFile}?dl=${show.presentationFile.originalFilename}`,
          _key: "presentation"
        }
      ]
    : [])
];
---

<Layout
  title={show.title}
  description={seoDescription}
  seoImage={show.seoImage || ""}
  type="article"
>
  <main class="show-page item-page">
    <h1>{show.title}</h1>
    <section class="page-grid">
      <div class="page-left">
        {/* Synopsis */}
        <PortableText
          class="synopsis"
          value={show.synopsis}
        />

        {/* Details section */}
        <section class="details">
          {/* Special links */}
          {
            (show.reservationLink || show.presentationFile) && (
              <DetailsParagraph links={specialLinks} />
            )
          }

          {
            show.infos && (
              <DetailsParagraph
                title="Informations"
                portableText={show.infos}
              />
            )
          }
          {
            show.production && (
              <DetailsParagraph
                title="Production"
                paragraph={show.production}
              />
            )
          }
          {
            show.supports && (
              <DetailsParagraph
                title="Soutiens"
                paragraph={show.supports}
              />
            )
          }
          {
            show.links && (
              <DetailsParagraph
                title="Liens"
                links={show.links}
              />
            )
          }
          {
            show.press && (
              <DetailsParagraph
                title="Presse"
                links={show.press}
              />
            )
          }
        </section>
      </div>

      <aside class="page-right">
        {/* Extrait */}
        {show.excerpt && <p class="excerpt">{show.excerpt}</p>}

        {/* Crédits */}
        {
          show.credits && (
            <div class="credits">
              {show.credits.map((credit) => (
                <>
                  <p class="credit-title">{credit.title}</p>
                  <div class="credit-value">
                    {credit.value?.map((value) =>
                      value?._type === "personText" ? (
                        <PortableText value={value.text} />
                      ) : (
                        <p>{value.name}</p>
                      )
                    )}
                  </div>
                </>
              ))}
            </div>
          )
        }
      </aside>
    </section>
  </main>
  {/* Galerie */}
  {show.gallery && <Gallery gallery={show.gallery} />}
</Layout>
