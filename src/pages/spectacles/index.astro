---
import { sanityClient } from "sanity:client";
import ContentList from "../../components/ContentList.astro";
import Layout from "../../layouts/Layout.astro";
import { showsListQuery } from "../../sanity/lib/queries";

const showsList = await sanityClient.fetch(showsListQuery);
if (!showsList) throw new Error("Shows not found");
const { title, slug, shows } = showsList;
if (shows.length === 1) {
  return Astro.rewrite(`/${slug}/${shows[0].slug}`);
}
---

<Layout title="Spectacles">
  <main class="list-page">
    <h1 class="sr-only">{title}</h1>
    <ContentList
      slug={slug}
      items={shows}
    />
  </main>
</Layout>
