---
import { sanityClient } from "sanity:client";
import Thumbnail from "../../components/Thumbnail.astro";
import Layout from "../../layouts/Layout.astro";
import { showsListQuery } from "../../sanity/lib/queries";

const showsList = await sanityClient.fetch(showsListQuery);
if (!showsList) throw new Error("Shows not found");
const { title, slug, shows } = showsList;
if (shows.length === 1) {
  return Astro.rewrite(`/${slug}/${shows[0].slug}`);
}
---

<Layout title="Spectacles">
  <main class="list-page">
    <h1 class="sr-only">{title}</h1>
    {
      shows.length > 0 ? (
        <section class="content-list shows-list">
          {shows.map((show) => (
            <Thumbnail
              parentSlug={slug}
              item={show}
            />
          ))}
        </section>
      ) : (
        <p>Aucun spectacle trouvé.</p>
      )
    }
  </main>
</Layout>
