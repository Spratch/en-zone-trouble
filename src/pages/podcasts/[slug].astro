---
import { sanityClient } from "sanity:client";
import PortableText from "../../components/PortableText.astro";
import Layout from "../../layouts/Layout.astro";
import {
  podcastBySlugQuery,
  podcastsListQuery
} from "../../sanity/lib/queries";
import Gallery from "../../components/Gallery.astro";
import DetailsParagraph from "../../components/DetailsParagraph.astro";

export async function getStaticPaths() {
  const podcastsList = await sanityClient.fetch(podcastsListQuery);
  if (!podcastsList) throw new Error("Podcasts not found");
  const { podcasts } = podcastsList;
  return podcasts.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const podcast = await sanityClient.fetch(podcastBySlugQuery, { slug });
if (!podcast) throw new Error("Podcast not found");
const audios = podcast.episodes
  ?.filter((episode) => episode.playbackId)
  .map((episode) => ({
    title: episode.title,
    playbackId: episode.playbackId
  }));
---

<Layout title={podcast.title}>
  <main class="podcast-page item-page">
    <h1>{podcast.title}</h1>
    <section class="page-grid">
      <div class="page-left">
        {/* Synopsis */}
        <PortableText
          class="synopsis-podcast"
          value={podcast.synopsis}
        />

        {/* Épisodes */}
        {
          podcast.episodes && podcast.episodes.length > 0 && (
            <section class="podcast-episodes">
              {podcast.episodes.map((episode, index) => (
                <p class="episode-item">
                  {episode.playbackId ? (
                    <button
                      class="episode-trigger"
                      aria-label={`Écouter l'épisode ${index + 1}`}
                      data-playback-id={episode.playbackId}
                      data-title={episode.title}
                    >
                      épisode {index + 1}
                    </button>
                  ) : (
                    <span>épisode {index}</span>
                  )}
                  <span class="episode-title">{episode.title}</span>
                </p>
              ))}
            </section>
          )
        }

        {/* Player */}
        {
          audios && audios.length > 0 && (
            <section class="audio">
              <p class="audio-title">{audios[0].title}</p>
              <audio
                src={`https://stream.mux.com/${audios[0].playbackId}.m3u8`}
                controls
                class="audio-player"
              />
            </section>
          )
        }

        {/* Details section */}
        <section class="details">
          {
            podcast.infos && (
              <DetailsParagraph
                title="Informations"
                portableText={podcast.infos}
              />
            )
          }
          {
            podcast.production && (
              <DetailsParagraph
                title="Production"
                paragraph={podcast.production}
              />
            )
          }
          {
            podcast.supports && (
              <DetailsParagraph
                title="Soutiens"
                paragraph={podcast.supports}
              />
            )
          }
          {
            podcast.links && (
              <DetailsParagraph
                title="Liens"
                links={podcast.links}
              />
            )
          }
          {
            podcast.press && (
              <DetailsParagraph
                title="Presse"
                links={podcast.press}
              />
            )
          }
        </section>
      </div>

      <aside class="page-right">
        {/* Crédits */}
        {
          podcast.credits && (
            <div class="credits">
              {podcast.credits.map((credit) => (
                <>
                  <p class="credit-title">{credit.title}</p>
                  <div class="credit-value">
                    {credit.value?.map((value) =>
                      value?._type === "personText" ? (
                        <PortableText value={value.text} />
                      ) : (
                        <p>{value.name}</p>
                      )
                    )}
                  </div>
                </>
              ))}
            </div>
          )
        }
      </aside>
    </section>
  </main>
  {/* Galerie */}
  {podcast.gallery && <Gallery gallery={podcast.gallery} />}
</Layout>

<script>
  const buttons = document.querySelectorAll("button.episode-trigger");
  const titleElement = document.querySelector(".audio-title");
  const player = document.querySelector(".audio-player");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const playbackId = button.getAttribute("data-playback-id");
      const title = button.getAttribute("data-title");

      if (playbackId && player) {
        player.setAttribute("src", `https://stream.mux.com/${playbackId}.m3u8`);
        if (title && titleElement) {
          titleElement.textContent = title;
        }
      }
    });
  });
</script>
