---
import { sanityClient } from "sanity:client";
import Img from "../../components/Img.astro";
import PortableText from "../../components/PortableText.astro";
import Layout from "../../layouts/Layout.astro";
import {
  podcastBySlugQuery,
  podcastsListQuery
} from "../../sanity/lib/queries";
import Gallery from "../../components/Gallery.astro";

export async function getStaticPaths() {
  const podcasts = await sanityClient.fetch(podcastsListQuery);
  return podcasts.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const podcast = await sanityClient.fetch(podcastBySlugQuery, { slug });
if (!podcast) throw new Error("Podcast not found");
---

<Layout title={podcast.title}>
  <main class="podcast-page item-page">
    <section class="page-grid">
      <div class="page-left">
        <h1>{podcast.title}</h1>

        {/* Synopsis */}
        <PortableText
          class="synopsis-podcast"
          value={podcast.synopsis}
        />

        {/* Épisodes */}
        {
          podcast.episodes && podcast.episodes.length > 0 && (
            <section class="podcast-episodes">
              {podcast.episodes.map((episode, index) => (
                <p class="episode-item">
                  {episode.playbackId ? (
                    <button
                      class="episode-trigger"
                      aria-label={`Écouter l'épisode ${index + 1}`}
                      data-playback-id={episode.playbackId}
                      data-title={episode.title}
                    >
                      épisode {index + 1}
                    </button>
                  ) : (
                    <span>épisode {index}</span>
                  )}
                  <span class="episode-title">{episode.title}</span>
                </p>
              ))}
            </section>
          )
        }

        <section class="details">
          {
            podcast.infos && (
              <PortableText
                class="infos"
                value={podcast.infos}
              />
            )
          }
          {podcast.production && <p class="production">{podcast.production}</p>}
          {
            podcast.supports && (
              <div class="supports">
                <h2>Soutiens</h2>
                <p class="supports-content">{podcast.supports}</p>
              </div>
            )
          }
          {
            podcast.links && (
              <div class="links">
                {podcast.links.map((link) => (
                  <div class="link-item-container">
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-item"
                    >
                      <span class="link-item-title">{link.title}</span>
                    </a>
                    {link.subtitle && (
                      <p class="link-item-subtitle">{link.subtitle}</p>
                    )}
                  </div>
                ))}
              </div>
            )
          }
          {
            podcast.press && (
              <div class="press">
                {podcast.press.map((link) => (
                  <div class="link-item-container">
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-item"
                    >
                      <span class="link-item-title">{link.title}</span>
                    </a>
                    {link.subtitle && (
                      <p class="link-item-subtitle">{link.subtitle}</p>
                    )}
                  </div>
                ))}
              </div>
            )
          }
        </section>
      </div>

      <aside class="page-right">
        {/* Player */}
        <section class="audio">
          <p class="audio-title"></p>
          <audio
            controls
            class="audio-player"
          ></audio>
        </section>

        {/* Crédits */}
        {
          podcast.credits && (
            <div class="credits">
              {podcast.credits.map((credit) => (
                <>
                  <p class="credit-title">{credit.title}</p>
                  <div class="credit-value">
                    {credit.value?.map((value) =>
                      value?._type === "personText" ? (
                        <PortableText value={value.text} />
                      ) : (
                        <p>{value.name}</p>
                      )
                    )}
                  </div>
                </>
              ))}
            </div>
          )
        }
      </aside>
    </section>
  </main>
  {/* Galerie */}
  {podcast.gallery && <Gallery gallery={podcast.gallery} />}
</Layout>

<script>
  const buttons = document.querySelectorAll("button.episode-trigger");
  const titleElement = document.querySelector(".audio-title");
  const player = document.querySelector(".audio-player");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const playbackId = button.getAttribute("data-playback-id");
      const title = button.getAttribute("data-title");

      if (playbackId && player) {
        player.setAttribute("src", `https://stream.mux.com/${playbackId}.m3u8`);
        if (title && titleElement) {
          titleElement.textContent = title;
        }
      }
    });
  });
</script>
