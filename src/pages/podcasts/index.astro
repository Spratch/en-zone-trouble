---
import { sanityClient } from "sanity:client";
import ContentList from "../../components/ContentList.astro";
import Layout from "../../layouts/Layout.astro";
import { podcastsListQuery } from "../../sanity/lib/queries";

const podcastsList = await sanityClient.fetch(podcastsListQuery);
if (!podcastsList) throw new Error("Podcasts not found");
const { title, slug, podcasts } = podcastsList;
if (podcasts.length === 1) {
  return Astro.rewrite(`/${slug}/${podcasts[0].slug}`);
}
---

<Layout title="Podcasts">
  <main class="list-page">
    <h1 class="sr-only">{title}</h1>
    <ContentList
      slug={slug}
      items={podcasts}
    />
  </main>
</Layout>
