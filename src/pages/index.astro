---
import { sanityClient } from "sanity:client";
import Img from "../components/Img.astro";
import Layout from "../layouts/Layout.astro";
import { homeImageQuery } from "../sanity/lib/queries";

const homeImage = await sanityClient.fetch(homeImageQuery);
---

<Layout>
  <h1 class="sr-only">En Zone Trouble</h1>
  {
    homeImage?.src && (
      <Img
        class="home-image"
        image={homeImage}
        fullWidth={true}
        priority={true}
      />
    )
  }
</Layout>
