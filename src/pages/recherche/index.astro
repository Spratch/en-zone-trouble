---
import { sanityClient } from "sanity:client";
import ContentList from "../../components/ContentList.astro";
import Layout from "../../layouts/Layout.astro";
import { researchsListQuery } from "../../sanity/lib/queries";

console.log("test");
const researchsList = await sanityClient.fetch(researchsListQuery);
if (!researchsList) throw new Error("Shows not found");
const { title, slug, researchs } = researchsList;
if (researchs.length === 1) {
  return Astro.rewrite(`/${slug}/${researchs[0].slug}`);
}
---

<Layout title={title}>
  <main class="list-page">
    <h1 class="sr-only">{title}</h1>
    <ContentList
      slug={slug}
      items={researchs}
    />
  </main>
</Layout>
