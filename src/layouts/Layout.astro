---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { sanityClient } from "sanity:client";
import Filter from "../components/Filter.astro";
import Footer from "../components/Footer.astro";
import Meta from "../components/Meta.astro";
import NekoGhost from "../components/NekoGhost.astro";
import { layoutSettingsQuery } from "../sanity/lib/queries";
import "./reset.css";
import "./styles.css";

const settings = await sanityClient.fetch(layoutSettingsQuery);

const { ...seo } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <link
      rel="icon"
      href={settings?.favicons?.dark}
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      href={settings?.favicons?.light}
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      href={settings?.favicons?.dark}
    />
    <Meta
      siteTitle={settings?.title || "En Zone Trouble"}
      siteDescription={settings?.description || ""}
      {...seo}
    />
    <Font
      cssVariable="--font-serif"
      preload
    />
    <Font
      cssVariable="--font-sans"
      preload
    />
    <Font
      cssVariable="--font-script"
      preload
    />
    <ClientRouter />
  </head>
  <body transition:animate="none">
    <Footer />
    <slot />
    <NekoGhost />
    <Filter />
  </body>
</html>
