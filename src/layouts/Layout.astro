---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { sanityClient } from "sanity:client";
import Filter from "../components/Filter.astro";
import Footer from "../components/Footer.astro";
import type { Props as MetaProps } from "../components/Meta.astro";
import Meta from "../components/Meta.astro";
import NekoGhost from "../components/NekoGhost.astro";
import { layoutSettingsQuery } from "../sanity/lib/queries";
import "./styles.css";
interface Props extends MetaProps {}

const settings = await sanityClient.fetch(layoutSettingsQuery);

const { ...seo } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <link
      rel="icon"
      href={settings?.favicons?.dark}
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      href={settings?.favicons?.light}
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      href={settings?.favicons?.dark}
    />
    <Meta
      siteTitle={settings?.title || "En Zone Trouble"}
      siteDescription={settings?.description || ""}
      siteSeoImage={settings?.seoImage || ""}
      {...seo}
    />
    <Font
      cssVariable="--font-serif"
      preload
    />
    <Font
      cssVariable="--font-sans"
      preload
    />
    <Font
      cssVariable="--font-script"
      preload
    />
    <script is:inline>
      (function () {
        var script = document.createElement("script");
        var viewTransitionsEnabled = document.querySelector(
          "meta[name='astro-view-transitions-enabled']"
        )?.content;

        script.setAttribute(
          "src",
          "https://analytics.josephclenet.fr/script.js"
        );
        script.setAttribute("defer", true);
        script.setAttribute(
          "data-website-id",
          "a32fcb18-c19a-4807-8d67-3c07a6a2459d"
        );
        script.setAttribute("data-do-not-track", "true");

        if (!!viewTransitionsEnabled) {
          script.setAttribute("data-astro-rerun", true);
        }

        var head = document.querySelector("head");
        head.appendChild(script);
      })();
    </script>
    <script
      src="https://analytics.josephclenet.fr/script.js"
      defer="true"
      data-website-id="a32fcb18-c19a-4807-8d67-3c07a6a2459d"
      data-do-not-track="true"
    ></script>
    <ClientRouter />
  </head>
  <body transition:animate="none">
    <Footer />
    <slot />
    <NekoGhost />
    <Filter />
  </body>
</html>
