---
import { PortableText as PortableTextInternal } from "astro-portabletext";
import type { PortableTextComponents } from "astro-portabletext/types";
import PortableBlock from "./PortableBlock.astro";
import PortableLink from "./PortableLink.astro";
import PortableMark from "./PortableMark.astro";
interface Props {
  value: any;
  class?: string;
}

const { value, class: className } = Astro.props;

const components: Partial<PortableTextComponents> = {
  block: {
    uppercase: PortableBlock
  },
  mark: {
    em: PortableMark,
    internalLink: PortableLink,
    link: PortableLink
  }
};
---

<div class:list={[className, "portable-text"]}>
  <PortableTextInternal
    value={value}
    components={components}
  />
</div>
