---
import { PortableText as PortableTextInternal } from "astro-portabletext";
import PortableLink from "./PortableLink.astro";

interface Props {
  value: any;
  class?: string;
}

const { value, class: className } = Astro.props;

const components = {
  mark: {
    internalLink: PortableLink,
    link: PortableLink
  }
};
---

<div class:list={[className, "portable-text"]}>
  <PortableTextInternal
    value={value}
    components={components}
  />
</div>
