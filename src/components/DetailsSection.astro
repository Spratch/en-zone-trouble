---
import type {
  PodcastBySlugQueryResult,
  ResearchBySlugQueryResult,
  ShowBySlugQueryResult
} from "../../sanity.types";
import DetailsParagraph from "./DetailsParagraph.astro";
import PortableText from "./PortableText.astro";

interface Props {
  item:
    | NonNullable<ShowBySlugQueryResult>
    | NonNullable<PodcastBySlugQueryResult>
    | NonNullable<ResearchBySlugQueryResult>;
}

const { item } = Astro.props;

const specialLinks = [
  ...(item.reservationLink
    ? [
        {
          title: "Réservation",
          url: item.reservationLink,
          _key: "reservation"
        }
      ]
    : []),
  ...(item.presentationFile
    ? [
        {
          title: "Fiche de présentation",
          url: `${item.presentationFile}?dl=${item.presentationFile.originalFilename}`,
          _key: "presentation"
        }
      ]
    : [])
];
---

<div class="details-wrapper">
  {
    "text" in item && item.text && (
      <PortableText
        value={item.text}
        class="research-text"
      />
    )
  }
  <section class="details">
    {
      (item.reservationLink || item.presentationFile) && (
        <DetailsParagraph
          links={specialLinks}
          class="special-links"
        />
      )
    }
    {
      item.infos && (
        <DetailsParagraph
          title="Informations"
          portableText={item.infos}
        />
      )
    }
    {
      item.production && (
        <DetailsParagraph
          title="Production"
          paragraph={item.production}
        />
      )
    }
    {
      item.supports && (
        <DetailsParagraph
          title="Soutiens"
          paragraph={item.supports}
        />
      )
    }
    {
      item.dates && (
        <DetailsParagraph
          title="Dates"
          dates={item.dates}
        />
      )
    }
    {
      item.links && (
        <DetailsParagraph
          title="Liens"
          links={item.links}
        />
      )
    }
    {
      item.press && (
        <DetailsParagraph
          title="Presse"
          links={item.press}
        />
      )
    }
    {
      item.captions && item.captions.length > 0 && (
        <DetailsParagraph
          title="Légendes"
          captions={item.captions}
        />
      )
    }
  </section>
</div>
