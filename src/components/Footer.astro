---
import { sanityClient } from "sanity:client";
import { footerSettingsQuery } from "../sanity/lib/queries";

const { pathname } = Astro.url;
const settings = await sanityClient.fetch(footerSettingsQuery);
const siteTitle = settings?.title;
const navigationLogo = settings?.navigationLogo;
const navigation = settings?.navigation;
const aboutItem = navigation?.at(-1);
---

<footer>
  {siteTitle && <div class="footer-titlewraper">
    <p class="footer-title flou">{siteTitle}</p>
    <p class="footer-title net">{siteTitle}</p>
  </div>}
  <nav class="footer-navigation">
    {
      navigationLogo && (
        <a href="/">
          <img class="navigation-logo" src={navigationLogo} alt="Logo" />
        </a>
      )
    }

    {
      navigation && (
        <ul role="list" class="navigation-pages">
          {navigation.map((item, index) => {
            if (index === navigation.length - 1) return null;
            return (
              <li role="listitem" class="navigation-item">
                <a
                  class:list={[
                    "navigation-link",
                    { active: pathname === `/${item.slug}` },
                  ]}
                  href={`/${item.slug}`}
                >
                  {item.title}
                </a>
              </li>
            );
          })}
        </ul>
      )
    }

    {
      aboutItem && (
        <a
          class:list={[
            "navigation-about",
            { active: pathname === `/${aboutItem.slug}` },
          ]}
          href={`/${aboutItem.slug}`}
        >
          {aboutItem.title}
        </a>
      )
    }
  </nav>
</footer>
