---
import { sanityClient } from "sanity:client";
import { footerSettingsQuery } from "../sanity/lib/queries";

const { pathname } = Astro.url;
const settings = await sanityClient.fetch(footerSettingsQuery);
const siteTitle = settings?.title;
const navigationLogo = settings?.navigationLogo;
const navigation = settings?.navigation;

function isActive(pathname: string, slug: string): boolean {
  const normalized = pathname.replace(/\/$/, "");
  return normalized.includes(slug);
}
---

<footer>
  {
    siteTitle && (
      <>
        <p
          class="footer-title flou"
          aria-hidden="true"
        >
          {siteTitle}
        </p>
        <p class="footer-title net">{siteTitle}</p>
      </>
    )
  }
  <nav class="footer-navigation">
    {
      navigationLogo && (
        <a
          href="/"
          title="Accueil"
        >
          <img
            class="navigation-logo"
            src={navigationLogo}
            aria-hidden="true"
          />
        </a>
      )
    }

    {
      navigation && (
        <ul
          role="list"
          class="navigation-pages"
        >
          {navigation.map((item, index) => {
            return (
              <li
                role="listitem"
                class="navigation-item"
              >
                <a
                  class:list={[
                    "navigation-link",
                    { active: isActive(pathname, item.slug) }
                  ]}
                  aria-current={
                    isActive(pathname, item.slug) ? "page" : undefined
                  }
                  href={`/${item.slug}`}
                >
                  {item.title}
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </nav>
</footer>
