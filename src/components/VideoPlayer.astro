---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"video"> {
  playbackId: string;
  class?: string;
}

const { playbackId, class: className, ...rest } = Astro.props;
---

<mux-video
  class:list={[className, "video-player"]}
  playback-id={playbackId}
  disable-tracking
  playsinline
  {...rest}
>
</mux-video>
