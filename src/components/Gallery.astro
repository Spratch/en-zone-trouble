---
import type { ShowBySlugQueryResult } from "../../sanity.types";
import Img from "./Img.astro";
import VideoPlayer from "./VideoPlayer.astro";

type GalleryType = NonNullable<NonNullable<ShowBySlugQueryResult>["gallery"]>;

interface Props {
  gallery: GalleryType;
}

const { gallery } = Astro.props;
---

<div class="gallery">
  {
    gallery.map((item) => {
      if (item._type === "galleryImage") {
        return (
          <Img
            class="gallery-item"
            image={item}
          />
        );
      }
      if (item._type === "galleryVideo") {
        return (
          <VideoPlayer
            class="gallery-item"
            playbackId={item.playbackId}
            autoplay
            loop
            muted={true}
          />
        );
      }
    })
  }
</div>

<script>
  import "@mux/mux-video";
</script>
