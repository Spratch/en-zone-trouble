---
import { ArrowTopRightIcon, DownloadIcon } from "@sanity/icons";
import { contentRoutes } from "../utils";

interface Props {
  href?: string;
  refType?: string;
  slug?: string;
  class?: string;
}

const { href, refType, slug, class: className } = Astro.props;

const url =
  href ??
  `${contentRoutes[refType as keyof typeof contentRoutes]}/${refType === "member" ? "" : slug}`;
const isExternal = href && href.startsWith("http");
const Icon = isExternal
  ? href.endsWith(".pdf")
    ? DownloadIcon
    : ArrowTopRightIcon
  : null;
---

<span class:list={["link", isExternal ? "external" : "internal", className]}
  ><a
    href={url}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    ><slot /></a
  >
  {Icon && <Icon />}</span
>
