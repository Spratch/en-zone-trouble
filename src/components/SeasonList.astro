---
import type { CalendarQueryResult } from "../../sanity.types";
import { contentRoutes } from "../utils";
import CustomLink from "./CustomLink.astro";

type Props = {
  seasons: NonNullable<NonNullable<CalendarQueryResult>["seasons"]>;
  isClassic?: boolean;
};

const { seasons, isClassic = true } = Astro.props;
---

<ul class="seasons">
  {
    seasons.map((season) => (
      <li class:list={[{ "season-item": isClassic }]}>
        <h2 class="season-range">Saison {season.range}</h2>

        {/* Événements */}
        <ul class="season-events events-list">
          {season.events.map((event) => (
            <li class:list={[{ "event-item": isClassic }]}>
              {/* Titre de l'événement */}
              <h3 class="event-title">{event.title}</h3>
              {event.description && (
                <p class="event-description">{event.description}</p>
              )}

              {/* Informations sur l'événement */}
              {(event.date || event.place) && (
                <p class="event-infos">
                  {event.date && <span class="event-date">{event.date}</span>}
                  {event.place && (
                    <span class="event-place">{event.place}</span>
                  )}
                </p>
              )}

              {/* Projet associé à l'événement */}
              {event.project && (
                <CustomLink
                  href={`${contentRoutes[event.project._type]}/${event.project.slug}`}
                  class="event-project"
                >
                  {event.project.title}
                </CustomLink>
              )}

              {event.link && (
                <CustomLink href={event.link}>En savoir plus</CustomLink>
              )}
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>
