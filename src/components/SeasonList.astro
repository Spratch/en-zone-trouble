---
import type { CalendarQueryResult } from "../../sanity.types";
import { contentRoutes } from "../utils";

type Props = {
  seasons: NonNullable<NonNullable<CalendarQueryResult>["seasons"]>;
};

const { seasons } = Astro.props;
---

<ul class="seasons">
  {
    seasons.map((season) => (
      <li class="season-item">
        <h2 class="season-range">Saison {season.range}</h2>

        {/* Événements */}
        <ul class="season-events">
          {season.events.map((event) => (
            <li class="event-item">
              {/* Titre de l'événement */}
              <h3 class="event-title">{event.title}</h3>

              {/* Informations sur l'événement */}
              {(event.date || event.place) && (
                <p class="event-infos">
                  {event.date && <span class="event-date">{event.date}</span>}
                  {event.place && (
                    <span class="event-place">{event.place}</span>
                  )}
                </p>
              )}

              {/* Projet associé à l'événement */}
              {event.project && (
                <a
                  href={`${contentRoutes[event.project._type]}/${event.project.slug}`}
                  class="event-project"
                >
                  {event.project.title}
                </a>
              )}
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>
